{
  "name": "agencia-ti-video",
  "version": "1.0.0",
  "description": "Vídeo explicativo da Agência TI (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render AgenciaTI ../public/video/agencia-ti.mp4 --codec=h264 --crf=26",
    "poster": "remotion still AgenciaTI ../public/video/poster.jpg --frame=60",
    "voice": "node --env-file-if-exists=../.env.local scripts/voice.mts",
    "timeline": "node scripts/timeline.mts"
  },
  "allowScripts": {
    "esbuild": false
  }
}
